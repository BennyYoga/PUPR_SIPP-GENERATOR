{
  "manifest_version": 3,
  "name": "SIPP Generator",
  "version": "1.0",
  "description": "Ekstensi untuk melakukan generate Excel pada SIPP",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logo-inactive-16.png",
      "48": "images/logo-inactive-32.png",
      "128": "images/logo-inactive-64.png"
    },
    "default_title": "IE-Chart"
  },
  "icons": {
    "16": "images/logo-16.png",
    "48": "images/logo-32.png",
    "128": "images/logo-64.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
